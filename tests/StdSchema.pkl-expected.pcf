  ["staff"] {
    """
    schemaVersion = "1.0.0-dev"
    staff {
      installAllRequiredToolsOnConnect = false
      autoVerifySpellsAndHexesAfterCasting = true
    }
    
    """
  }
  ["sigilCase"] {
    """
    schemaVersion = "1.0.0-dev"
    sigilCase {
      sigils {
        ["secretKey1"] = "single line encrypted value"
        ["secretKey2"] = "multi line encrypted value"
        ["secretKey3"] = "single line encrypted value"
      }
    }
    
    """
  }
