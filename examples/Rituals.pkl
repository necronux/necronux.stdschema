@ModuleInfo { minPklVersion = "0.27.0" }

amends "../stdschema/Grimoire.pkl"

import "pkl:Project" as pklProject

grimoireMetadata {
  ...grimoireMetadata()
}

grimoireContents {
  ...grimoireMetadata()
  chapters {
    ["testChapter"] {
      ...grimoireMetadata()
      name = "A test chapter"
      spells {
        ["testSpell"] {
          ...grimoireMetadata()
          name = "test spell"
          castInvocation {
            tool {
              new {
                name = "bash"
                executable = "bash"
                provisioningStrategy {
                  new ToolManagerProvisioningBinding {
                    toolManager {
                      name = "bash"
                      executable = "bash"
                    }
                    provisioningCommands {
                      new {
                        installCommand = "bash"
                        verifyCommand = "bash --version"
                        uninstallCommand = "bash"
                      }
                    }
                  }
                }
              }
            }
            executionCommand = "scripts/script.sh"
            instrumentPath = "scripts/script.sh"
          }
          verifyInvocation = this.castInvocation
          dispelInvocation = this.castInvocation
          requiresConfirmation = false
        }
      }
      hexes {
        ["testHex"] {
          ...grimoireMetadata()
          name = "test hex"
          castInvocation = module.grimoireContents.chapters["testChapter"].spells["testSpell"].castInvocation
          verifyInvocation = this.castInvocation
          requiresConfirmation = false
        }
      }
    }
  }
  rituals {
    ["testRitual"] {
      ...grimoireMetadata()
      name = "A test ritual"
      description = "A test ritual description"
      steps {
        new RitualSpellStep {
          invocationType = "cast"
          spell =  module.grimoireContents.chapters["testChapter"].spells["testSpell"]
        }
        new RitualSpellStep {
          invocationType = "verify"
          spell =  module.grimoireContents.chapters["testChapter"].spells["testSpell"]
        }
        new RitualSpellStep {
          invocationType = "dispel"
          spell =  module.grimoireContents.chapters["testChapter"].spells["testSpell"]
        }
        new RitualHexStep {
          invocationType = "cast"
          hex = module.grimoireContents.chapters["testChapter"].hexes["testHex"]
        }
        new RitualHexStep {
          invocationType = "verify"
          hex = module.grimoireContents.chapters["testChapter"].hexes["testHex"]
        }
      }
      requiresConfirmation = true
    }
  }
  autoRitualsSequence {
    module.grimoireContents.rituals["testRitual"]
  }
}

local function grimoireMetadata() = new {
  grimoireName = "Test Grimoire"
  grimoireVersion = "0.0.0"
  grimoireLicense = "Apache-2.0"
}
