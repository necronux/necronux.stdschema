@ModuleInfo { minPklVersion = "0.27.0" }

amends "../stdschema/Grimoire.pkl"

import "pkl:Project" as pklProject

import "SecondGrimoire.pkl" as SecondGrimoire

local function thirdGrimoireMetadata() = new {
  grimoireName = "Third Test Grimoire"
  grimoireVersion = "0.0.0"
  grimoireAuthors = new Listing<pklProject.EmailAddress> {
    "Nayan (NayanTheSpaceGuy) <nayantsg@proton.me>"
  }
  grimoireLicense = "Apache-2.0"
  grimoireAdditionalMetadata = new Mapping {
    ["exampleTool"] = new Mapping {
      ["flag1"] = true
      ["depth"] = 2
      ["title"] = "text"
    }
  }
}

grimoireMetadata {
  ...thirdGrimoireMetadata()
}

coreContents {
  ...thirdGrimoireMetadata()

  chapters {
    ["thirdTestChapter"] {
      ...thirdGrimoireMetadata()
      name = "Third Test Chapter"
      description = "Third Test Chapter description"

      spells {
        ["thirdTestSpell"] {
          ...thirdGrimoireMetadata()
          name = "Third Test Spell"
          description = "Third Test Spell description"

          requiresConfirmation = false
          keywords {
            "bash"
          }

          castInvocation {
            prefixArgs = "LOG=info"
            executionCommand = "ansible-playbook " + instrumentPath
            instrumentPath = "ansible/playbooks/playbook1.yml"

            tool {
              new {
                name = "ansible"
                executable = "ansible"
                provisioningStrategy {
                  new ToolProvisioningBinding {
                    toolProvisioner {
                      name = "yay"
                      executable = "yay"
                    }
                    provisioningCommands {
                      installCommandPrefixArgs = "LOG=info"
                      installCommand = "yay -S ansible"
                      verifyCommandPrefixArgs = "LOG=info"
                      verifyCommand = "ansible --version"
                      uninstallCommandPrefixArgs = "LOG=info"
                      uninstallCommand = "yay -R ansible"
                    }
                  }
                  new ToolProvisioningBinding {
                    toolProvisioner {
                      name = "paru"
                      executable = "paru"
                    }
                    provisioningCommands {
                      installCommandPrefixArgs = "LOG=info"
                      installCommand = "paru -S yay"
                      verifyCommandPrefixArgs = "LOG=info"
                      verifyCommand = "yay --version"
                      uninstallCommandPrefixArgs = "LOG=info"
                      uninstallCommand = "paru -R ansible"
                    }
                  }
                  new ToolProvisionerFallbacks {
                    fallbacks {
                      new ToolProvisioningBinding {
                        toolProvisioner {
                          name = "bash"
                          executable = "bash"
                        }
                        provisioningCommands {
                          installCommandPrefixArgs = "LOG=info"
                          installCommand = "bash clone && cd && makepkg"
                          verifyCommandPrefixArgs = "LOG=info"
                          verifyCommand = "paru --version"
                          uninstallCommandPrefixArgs = "LOG=info"
                          uninstallCommand = "bash rm dir rm usr bin"
                        }
                      }
                      new ToolProvisioningBinding {
                        toolProvisioner {
                          name = "zsh"
                          executable = "zsh"
                        }
                        provisioningCommands {
                          installCommandPrefixArgs = "LOG=info"
                          installCommand = "zsh clone && cd && makepkg"
                          verifyCommandPrefixArgs = "LOG=info"
                          verifyCommand = "paru --version"
                          uninstallCommandPrefixArgs = "LOG=info"
                          uninstallCommand = "zsh rm dir rm usr bin"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          verifyInvocation = this.castInvocation
          dispelInvocation = this.castInvocation
        }
      }
    }
  }

  autoPerformRituals {
    module.coreContents.linkedGrimoires["secondLinkedGrimoire"].compositeRituals["secondTestCompositeRitual"]
  }

  linkedGrimoires {
    ["secondLinkedGrimoire"] {
      coreContents = SecondGrimoire.coreContents

      compositeRituals {
        ["secondTestCompositeRitual"] = SecondGrimoire.coreContents.compositeRituals["secondTestCompositeRitual"]
      }
    }
  }
}

sigils {
  ["secretKey1"] = "single line encrypted value"
  ["secretKey2"] = """
    multi line encrypted value
    """
  ["secretKey3"] = this["secretKey1"]
}

enchantments {
  installAllRequiredToolsOnConnect = false
  autoVerifySpellsAndHexesAfterCasting = true
}
