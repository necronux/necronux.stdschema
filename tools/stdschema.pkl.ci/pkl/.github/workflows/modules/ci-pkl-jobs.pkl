@ModuleInfo { minPklVersion = "0.27.0" }
module CiPklJobs

import "@internal/schemas/GitHubAction.pkl" as gha

import "@internal/gha/StepsCommon.pkl"
import "@internal/gha/UtilsCommon.pkl"

const function resolveCheck() = new gha.Job {
  name = "Resolve Check"
  steps {
    StepsCommon.checkout(null)
    StepsCommon.installAction("just")
    new {
      name = "Check if necronux.stdschema pkl project can be resolved"
      run = "just resolve-stdschema"
      shell = "bash"
    }
    new {
      name = "Check if stdschema.pkl.ci pkl project can be resolved"
      run = "just resolve-stdschemapklci"
      shell = "bash"
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)

const function evalCheck() = new gha.Job {
  name = "Eval Check"
  steps {
    StepsCommon.checkout(null)
    StepsCommon.installAction("just")
    new {
      name = "Check if stdschema.pkl.ci pkl modules can be evaluated"
      run = "just eval-stdschemapklci"
      shell = "bash"
    }
    new {
      name = "Verify pkl modules evaluation reflects the latest changes"
      run = "git diff --exit-code"
      shell = "bash"
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)

const function tests() = new gha.Job {
  name = "Tests"
  steps {
    StepsCommon.checkout(null)
    StepsCommon.installAction("just")
    new {
      name = "Test necronux.stdschema pkl modules"
      run = "just test-stdschema"
      shell = "bash"
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)

const function versionCheck() = new gha.Job {
  name = "Version Check"
  steps {
    StepsCommon.checkout(null)
    new {
      name = "Check if pkl project version is same in all stdschema files"
      run = """
        files=("stdschema/Grimoire.pkl" "stdschema/SigilCase.pkl" "stdschema/Staff.pkl")
        versions=()

        for file in "${files[@]}"; do
          version=$(awk -F '"' '/^hidden const stdSchemaPklPkgVersion:/ {print $2; exit}' "$file")
          if [ -z "$version" ]; then
            echo "Error: No version found in $file"
            exit 1
          fi
          echo "Extracted version from $file: '$version'"
          versions+=("$version")
        done

        first="${versions[0]}"
        for v in "${versions[@]:1}"; do
          if [ "$v" != "$first" ]; then
            echo "Error: Inconsistent stdSchemaPklPkgVersion values detected."
            echo "Versions found: ${versions[*]}"
            exit 1
          fi
        done
        """
      shell = "bash"
    }
  }
} |> UtilsCommon.standardJobConfig(null, null)
