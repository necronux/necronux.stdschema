/// A template for writing Necronux SigilCase.
@ModuleInfo { minPklVersion = "0.27.0" }
open module necronux.stdschema.SigilCase

/// The standard schema pkl package version.
hidden const stdSchemaPklPkgVersion: String = "0.2.0"

/// The version of standard schema used for this sigil case.
const stdSchemaVersion: String = stdSchemaPklPkgVersion

/// An identifier (key) for the sigil.
typealias Key = String(!isEmpty)

/// The secret value of the sigil.
typealias Value = String(!isEmpty)

/// A container for sigils.
open class SigilCase {
  /// A mapping of secret sigil values associated with their sigil key.
  sigils: Mapping<Key, Value>
}

/// A sigil case to hold sigils.
///
/// Used to securely store sigils (secret key-value pairs).
sigilCase: SigilCase
