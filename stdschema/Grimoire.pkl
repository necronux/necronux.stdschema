/// A template for writing Necronux grimoire.
@ModuleInfo { minPklVersion = "0.27.0" }
open module necronux.stdschema.Grimoire

import "pkl:Project" as pklProject
import "pkl:semver" as pklSemver

/// The encrypted secret value.
typealias Sigil = String

/// The grimoire metadata.
open class GrimoireMetadata {
  /// The version of standard schema used for this grimoire.
  const stdSchemaVersion: String = module.stdSchemaVersion

  /// The name of this grimoire.
  ///
  /// The grimoire name is only used for display purposes.
  ///
  /// Example:
  /// ```
  /// grimoireName = "mygrimoire"
  /// ```
  grimoireName: String

  /// The version of this grimoire.
  ///
  /// Must adhere to semantic versioning.
  ///
  /// Example:
  /// ```
  /// grimoireVersion = "1.1.0"
  /// ```
  grimoireVersion: String(pklSemver.isValid(this))

  /// The description of this grimoire.
  grimoireDescription: String?

  /// The maintainers' emails for this grimoire.
  ///
  /// Email addresses must adhere to
  /// [RFC5322 mailbox](https://www.rfc-editor.org/rfc/rfc5322#section-3.4) specification.
  ///
  /// Example:
  /// ```
  /// grimoireAuthors { "John Doe <john.doe@example.com>" }
  /// ```
  grimoireAuthors: Listing<pklProject.EmailAddress>?

  /// The source code repository for this grimoire.
  ///
  /// Example:
  /// ```
  /// grimoireSourceCode = "https://github.com/myorg/mygrimoireproject"
  /// ```
  grimoireSourceCode: String?

  /// The website for this grimoire.
  ///
  /// Example:
  /// ```
  /// grimoireWebsite = "https://example.com/mygrimoireproject"
  /// ```
  grimoireWebsite: String?

  /// The web URL of the Pkldoc documentation for this grimoire.
  grimoireDocumentation: Uri(!endsWith("/"))?

  /// The path to this grimoire’s README file.
  grimoireReadme: String?

  /// The license associated with this grimoire.
  ///
  /// If using a common license, use its [SPDX license identifier](https://spdx.org/licenses/).
  ///
  /// If using multiple common licenses, use a
  /// [SPDX license expression syntax version 2.0 string](https://spdx.github.io/spdx-spec/v2.3/SPDX-license-expressions/).
  /// For example: `"Apache-2.0 or MIT"`.
  ///
  /// If using an uncommon license, also provide its full text in the [licenseText] property.
  ///
  /// Example:
  /// ```
  /// grimoireLicense = "Apache-2.0"
  /// ```
  grimoireLicense: pklProject.CommonSpdxLicenseIdentifier|String

  /// The full text of the license associated with this grimoire.
  grimoireLicenseText: String?

  /// The web URL of the issue tracker for this grimoire.
  grimoireIssueTracker: String?

  /// The keywords (tags) associated with this grimoire.
  grimoireKeywords: Listing<String>?

  /// Extra settings for external tools.
  grimoireAdditionalMetadata: Mapping<String, Mapping<String, String|Boolean|Number>>?
}

/// A tool that has the ability to provision another tool.
open class ToolProvisioner {
  /// The name of this tool provisioner (tool).
  name: String

  /// The executable file name or path of this tool provisioner (tool).
  ///
  /// Example:
  /// ```
  /// executable = "/usr/bin/executableFileName"
  /// or
  /// executable = "executableFileName"
  /// ```
  executable: String
}

/// The provisioning commands to provision a tool.
open class ToolProvisioningCommands {
  /// The arguments to prepend before the install command.
  installCommandPrefixArgs: String?

  /// The command to install the dependent tool.
  ///
  /// The install command can optionally contain appending arguments.
  installCommand: String

  /// The arguments to prepend before the verify command.
  verifyCommandPrefixArgs: String?

  /// The command to verify dependent tool installation.
  ///
  /// The verify command can optionally contain appending arguments.
  verifyCommand: String

  /// The arguments to prepend before the uninstall command.
  uninstallCommandPrefixArgs: String?

  /// The command to uninstall the dependent tool.
  ///
  /// The uninstall command can optionally contain appending arguments.
  uninstallCommand: String
}

/// A binding that binds a tool provisioner and tool provisioning commands for a dependent tool.
open class ToolProvisioningBinding {
  /// The tool provisioner used for provisioning of the dependent tool.
  toolProvisioner: ToolProvisioner

  /// The provisioning commands used for provisioning of the dependent tool.
  provisioningCommands: ToolProvisioningCommands
}

/// A tool provisioner fallback mechanism.
open class ToolProvisionerFallbacks {
  /// The fallback list of tool provisioning bindings to use if primary fails.
  ///
  /// This list can have fallbacks and is iterated in a sequence.
  /// If first fails, then try second and so on.
  fallbacks: Listing<ToolProvisioningBinding>
}

/// A tool that has the ability to take an instrument as an argument.
open class Tool {
  /// The name of this tool.
  name: String

  /// The executable file name or path of this tool.
  ///
  /// Example:
  /// ```
  /// executable = "/usr/bin/executableFileName"
  /// or
  /// executable = "executableFileName"
  /// ```
  executable: String

  /// The strategy for provisioning this tool and its dependencies.
  ///
  /// Each element in this list becomes a dependency of the prior element.
  /// If a tool has conditional dependency, for eg., bash on linux and powershell on windows then use fallbacks.
  ///
  /// Example:
  /// ```
  /// provisioningStrategy {
  ///   new ToolProvisioningBinding { ... }
  ///   new ToolProvisioningBinding { ... } // This becomes dependency of the previous element.
  ///   new ToolProvisionerFallbacks {
  ///     fallbacks {
  ///       // This is tried first
  ///       new ToolProvisioningBinding { ... } // This becomes dependency of the previous provisioningStrategy element.
  ///       // If the above element fails, then this is tried
  ///       new ToolProvisioningBinding { ... } // This becomes dependency of the previous provisioningStrategy element.
  ///     }
  ///   }
  ///   new ToolProvisionerFallbacks {
  ///     fallbacks {
  ///       // This is tried first
  ///       new ToolProvisioningBinding { ... } // This becomes dependency of both fallback elements of the previous provisioningStrategy element.
  ///       // If the above element fails, then this is tried
  ///       new ToolProvisioningBinding { ... } // This becomes dependency of both fallback elements of the previous provisioningStrategy element.
  ///     }
  ///   }
  ///   new ToolProvisioningBinding { ... } // This becomes dependency of both fallback elements of the previous provisioningStrategy element.
  /// }
  /// ```
  provisioningStrategy: Listing<ToolProvisioningBinding|ToolProvisionerFallbacks>
}

/// An invocation that constructs a command and defines its dependencies.
///
/// This invocation is constructed as prefixArgs + tool.executable + executionCommand
open class Invocation {
  /// The arguments to prepend before the execution command.
  prefixArgs: String?

  /// The command to 'execute' the instrument.
  ///
  /// The execution command can optionally contain appending arguments.
  executionCommand: String

  /// The path to the instrument.
  ///
  /// The instrument can be any file or resource that the tool can take as an argument.
  /// e.g., a script, a configuration file, or a binary artifact.
  instrumentPath: String

  /// The tool used for this invocation.
  ///
  /// This list can have fallbacks and is iterated in a sequence.
  /// If first fails, then try second and so on.
  ///
  /// Example:
  /// ```
  /// tool {
  ///   // This is tried first
  ///   new Tool { ... }
  ///   // If the above element fails, then this is tried
  ///   new Tool { ... }
  ///   // If the above element fails, then this is tried
  ///   new Tool { ... }
  /// }
  /// ```
  tool: Listing<Tool>
}

/// A logical grouping of revertible invocation, and its verification invocation and reverter invocation.
open class Spell extends GrimoireMetadata {
  /// The type of magic.
  const magicType: String = "spell"

  /// The name of this spell.
  name: String

  /// The description of this spell.
  description: String?

  /// Whether to prompt for confirmation before casting or dispelling this spell.
  requiresConfirmation: Boolean = false

  /// The keywords (tags) associated with this spell.
  keywords: Listing<String>?

  /// The invocation to cast / perform this spell.
  castInvocation: Invocation

  /// The invocation to verify the casting of this spell.
  verifyInvocation: Invocation

  /// The invocation to dispel / undo this spell.
  dispelInvocation: Invocation
}

/// A logical grouping of non-revertible invocation and its verification invocation.
open class Hex extends GrimoireMetadata {
  /// The type of magic.
  const magicType: String = "hex"

  /// The name of this hex.
  name: String

  /// The description of this hex.
  description: String?

  /// Whether to prompt for confirmation before casting this hex.
  requiresConfirmation: Boolean = true

  /// The keywords (tags) associated with this hex.
  keywords: Listing<String>?

  /// The invocation to cast / perform this hex.
  castInvocation: Invocation

  /// The invocation to verify the casting of this hex.
  verifyInvocation: Invocation
}

/// A logical grouping of spells and hexes.
open class Chapter extends GrimoireMetadata {
  /// The name of this chapter.
  name: String

  /// The description of this chapter.
  description: String?

  /// The spells in this chapter associated with an identifier.
  spells: Mapping<String, Spell>?

  /// The hexes in this chapter associated with an identifier.
  hexes: Mapping<String, Hex>?

  /// Whether to prompt for confirmation before casting spells and hexes or dispelling spells of this chapter.
  requiresConfirmation: Boolean = false
}

/// A ritual cast step.
open class RitualCastStep {
  /// The spell or hex to cast in this ritual step.
  cast: Spell|Hex

  /// Whether to prompt for confirmation before casting this spell or hex.
  requiresConfirmation: Boolean = false

  /// Whether to automatically verify casting of the spell or hex immediately after casting it.
  autoVerify: Boolean = false
}

/// A ritual dispel step.
open class RitualDispelStep {
  /// The spell to dispel in this ritual step.
  dispel: Spell

  /// Whether to prompt for confirmation before dispelling this spell.
  requiresConfirmation: Boolean = false
}

/// A logical sequence of invocations of spells and hexes.
open class Ritual extends GrimoireMetadata {
  /// The type of this ritual.
  const ritualType: String = "native"

  /// The name of this ritual.
  name: String

  /// The description of this ritual.
  description: String?

  /// Whether to prompt for confirmation before performing this ritual.
  requiresConfirmation: Boolean = true

  /// The keywords (tags) associated with this ritual.
  keywords: Listing<String>?

  /// The logical sequence of ritual steps to perform.
  ///
  /// Example:
  /// ```
  /// steps {
  ///   // Each step's invocation is done sequentially
  ///   new RitualCastStep { ... }
  ///   new RitualDispelStep { ... }
  ///   new RitualDispelStep { ... }
  /// }
  /// ```
  steps: Listing<RitualCastStep|RitualDispelStep>
}

/// A composite ritual.
///
/// A composite ritual is a special type of [Ritual] which allows a ritual to also have spells and hexes from linked grimoires.
open class CompositeRitual extends GrimoireMetadata {
  /// The type of this ritual.
  const ritualType: String = "composite"

  /// The name of this composite ritual.
  name: String

  /// The description of this composite ritual.
  description: String?

  /// Whether to prompt for confirmation before performing this composite ritual.
  requiresConfirmation: Boolean = true

  /// The keywords (tags) associated with this composite ritual.
  keywords: Listing<String>?

  /// The logical sequence of ritual steps to perform.
  ///
  /// Example:
  /// ```
  /// steps {
  ///   // Each step's invocation is done sequentially
  ///   new RitualCastStep { ... }
  ///   new RitualDispelStep { ... }
  ///   new RitualDispelStep { ... }
  /// }
  /// ```
  steps: Listing<Any>
}

/// A linked (imported) grimoire.
///
/// A grimoire can be linked with another grimoire fully or with its individual linkable objects selectively.
open class LinkedGrimoire {
  /// The core contents to be linked from this linked grimoire.
  ///
  /// Example:
  /// ```
  /// coreContents = new CoreContents { ... }
  /// ```
  coreContents: Any?

  /// The chapters to be linked from this linked grimoire associated with an alias identifier.
  ///
  /// Example:
  /// ```
  /// chapters {
  ///   ["example"] {
  ///     new Chapter { ... }
  ///   }
  /// }
  /// ```
  chapters: Mapping<String, Any>?

  /// The rituals to be linked from this linked grimoire associated with an alias identifier.
  ///
  /// Example:
  /// ```
  /// rituals {
  ///   ["example"] {
  ///     new Ritual { ... }
  ///   }
  /// }
  /// ```
  rituals: Mapping<String, Any>?

  /// The composite rituals to be linked from this linked grimoire associated with an alias identifier.
  ///
  /// Example:
  /// ```
  /// compositeRituals {
  ///   ["example"] {
  ///     new CompositeRitual { ... }
  ///   }
  /// }
  /// ```
  compositeRituals: Mapping<String, Any>?

  /// The spells to be linked from this linked grimoire associated with an alias identifier.
  ///
  /// Example:
  /// ```
  /// spells {
  ///   ["example"] {
  ///     new Spell { ... }
  ///   }
  /// }
  /// ```
  spells: Mapping<String, Any>?

  /// The hexes to be linked from this linked grimoire associated with an alias identifier.
  ///
  /// Example:
  /// ```
  /// hexes {
  ///   ["example"] {
  ///     new Hex { ... }
  ///   }
  /// }
  /// ```
  hexes: Mapping<String, Any>?

  /// Whether to prompt for confirmation before casting spells and hexes or dispelling spells or performing rituals from this linked grimoire.
  requiresConfirmation: Boolean = true
}

/// The core contents.
open class CoreContents extends GrimoireMetadata {
  /// The chapters in this grimoire associated with an identifier.
  chapters: Mapping<String, Chapter>

  /// The rituals in this grimoire associated with an identifier.
  rituals: Mapping<String, Ritual>?

  /// The composite rituals in this grimoire associated with an identifier.
  ///
  /// It is advised to not use this composite ritual approach if the ritual does not have any spells and hexes from a linked grimoire.
  /// This composite ritual approach removes the limiting conformance of this grimoire's schema version for spells and hexes from other grimoires which may use different schema versions.
  ///
  /// Example:
  /// ```
  /// compositeRituals {
  ///   ["example"] {
  ///     new CompositeRitual { ... }
  ///   }
  /// }
  /// ```
  compositeRituals: Mapping<String, CompositeRitual>?

  /// The logical sequence of rituals to auto perform immediately after connecting the grimoire.
  ///
  /// Example:
  /// ```
  /// autoPerformRituals {
  ///   new Ritual { ... }
  ///   new Ritual { ... }
  /// }
  /// ```
  autoPerformRituals: Listing<Any>?

  /// The external grimoires to be linked with this grimoire associated with an identifier.
  ///
  /// It is advised to use this linked grimoires approach rather than directly injecting objects from other grimoires.
  /// This linked grimoires approach removes the limiting conformance of this grimoire's schema version for other grimoires which may use different schema versions.
  linkedGrimoires: Mapping<String, LinkedGrimoire>?

  /// Whether to prompt for confirmation before casting spells and hexes or dispelling spells or performing rituals of this grimoire.
  requiresConfirmation: Boolean = false
}

/// The enchantments.
///
/// Enchantments are used to configure the runtime behavior of an user facing app such as a CLI or a GUI app.
open class Enchantments {
  /// Whether to install all required tools immediately after connecting the grimoire.
  ///
  /// Ensures all dependent tools are ready before casting or verifying.
  installAllRequiredToolsOnConnect: Boolean = false

  /// Whether to automatically verify the casting of spells and hexes immediately after casting them.
  autoVerifySpellsAndHexesAfterCasting: Boolean = false
}

/// The standard schema pkl package version.
hidden const stdSchemaPklPkgVersion: String = "0.3.0-dev"

/// The version of standard schema used for this grimoire.
const stdSchemaVersion: String = stdSchemaPklPkgVersion

/// The metadata of this grimoire that is required to be shared with all its linkable objects.
grimoireMetadata: GrimoireMetadata

/// The core contents of this grimoire.
coreContents: CoreContents

/// The sigils in this grimoire associated with an identifier.
sigils: Mapping<String, Sigil>?

/// The enchantments in this grimoire.
enchantments: Enchantments
